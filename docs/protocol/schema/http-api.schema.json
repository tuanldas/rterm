{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HTTP API của server (bản nháp v0)",
  "description": "Thân yêu cầu và phản hồi JSON của /v1. Endpoint, mã trạng thái và quy tắc xem docs/protocol/http-api.md. Không có additionalProperties:false: bên nhận bỏ qua trường lạ.",
  "$defs": {
    "Meta": {
      "description": "Phản hồi của GET /v1/meta, không cần đăng nhập.",
      "type": "object",
      "required": ["server_version", "api", "setup_required"],
      "properties": {
        "server_version": { "type": "string", "minLength": 1 },
        "api": { "const": 1 },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/Capability" },
          "uniqueItems": true
        },
        "setup_required": { "type": "boolean" }
      }
    },
    "APIError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      }
    },
    "ErrorResponse": {
      "description": "Thân của mọi phản hồi lỗi HTTP.",
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "$ref": "#/$defs/APIError" }
      }
    },
    "SetupRequest": {
      "description": "Thân của POST /v1/setup.",
      "type": "object",
      "required": ["setup_token", "email", "password"],
      "properties": {
        "setup_token": { "type": "string", "minLength": 1 },
        "email": { "type": "string", "minLength": 3 },
        "password": { "type": "string", "minLength": 1 }
      }
    },
    "SetupResult": {
      "description": "Phản hồi của POST /v1/setup: token tạm chỉ dùng để đăng ký TOTP.",
      "type": "object",
      "required": ["totp_enrollment_token"],
      "properties": {
        "totp_enrollment_token": { "type": "string", "minLength": 1 }
      }
    },
    "LoginRequest": {
      "description": "Thân của POST /v1/auth/login. Gửi totp hoặc recovery_code, không gửi cả hai.",
      "type": "object",
      "required": ["email", "password", "device_name"],
      "properties": {
        "email": { "type": "string", "minLength": 3 },
        "password": { "type": "string", "minLength": 1 },
        "totp": { "$ref": "#/$defs/TOTPCode" },
        "recovery_code": { "type": "string", "minLength": 1 },
        "device_name": { "type": "string", "minLength": 1 }
      },
      "not": { "required": ["totp", "recovery_code"] }
    },
    "TOTPCode": {
      "type": "string",
      "pattern": "^[0-9]{6}$"
    },
    "TokenPair": {
      "description": "Cặp token sau khi xác thực. Token là chuỗi không trong suốt.",
      "type": "object",
      "required": ["access_token", "refresh_token", "access_expires_at"],
      "properties": {
        "access_token": { "type": "string", "minLength": 1 },
        "refresh_token": { "type": "string", "minLength": 1 },
        "access_expires_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" }
      }
    },
    "RefreshRequest": {
      "description": "Thân của POST /v1/auth/refresh; phản hồi là TokenPair.",
      "type": "object",
      "required": ["refresh_token"],
      "properties": {
        "refresh_token": { "type": "string", "minLength": 1 }
      }
    },
    "StepUpRequest": {
      "description": "Thân của POST /v1/auth/step-up.",
      "type": "object",
      "required": ["totp"],
      "properties": {
        "totp": { "$ref": "#/$defs/TOTPCode" }
      }
    },
    "TOTPEnrollment": {
      "description": "Phản hồi của POST /v1/auth/totp/enroll.",
      "type": "object",
      "required": ["secret", "otpauth_uri"],
      "properties": {
        "secret": { "type": "string", "pattern": "^[A-Z2-7]+=*$" },
        "otpauth_uri": { "type": "string", "pattern": "^otpauth://totp/" }
      }
    },
    "TOTPConfirmRequest": {
      "description": "Thân của POST /v1/auth/totp/confirm.",
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "$ref": "#/$defs/TOTPCode" }
      }
    },
    "TOTPConfirmResult": {
      "description": "Phản hồi khi xác nhận TOTP: TokenPair cộng mã khôi phục chỉ hiện đúng một lần.",
      "allOf": [
        { "$ref": "#/$defs/TokenPair" },
        {
          "type": "object",
          "required": ["recovery_codes"],
          "properties": {
            "recovery_codes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "Me": {
      "description": "Phản hồi của GET /v1/me.",
      "type": "object",
      "required": ["id", "email", "totp_enabled", "created_at"],
      "properties": {
        "id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "email": { "type": "string", "minLength": 3 },
        "totp_enabled": { "type": "boolean" },
        "soft_locked_until": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "created_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" }
      }
    },
    "ChangePasswordRequest": {
      "description": "Thân của POST /v1/me/password.",
      "type": "object",
      "required": ["current_password", "new_password"],
      "properties": {
        "current_password": { "type": "string", "minLength": 1 },
        "new_password": { "type": "string", "minLength": 1 }
      }
    },
    "Device": {
      "type": "object",
      "required": ["id", "name", "created_at", "last_used_at", "current"],
      "properties": {
        "id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "name": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "last_used_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "current": { "type": "boolean" }
      }
    },
    "DeviceList": {
      "description": "Phản hồi của GET /v1/me/devices.",
      "type": "object",
      "properties": {
        "devices": { "type": "array", "items": { "$ref": "#/$defs/Device" } }
      }
    },
    "Alert": {
      "description": "Cảnh báo hiện trong app. action là tập mở; app hiện thông báo chung cho hành động lạ.",
      "type": "object",
      "required": ["id", "action", "ts"],
      "properties": {
        "id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "action": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "ts": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "machine_id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "target": { "type": "string" }
      }
    },
    "AlertList": {
      "description": "Phản hồi của GET /v1/me/alerts.",
      "type": "object",
      "properties": {
        "alerts": { "type": "array", "items": { "$ref": "#/$defs/Alert" } }
      }
    },
    "KeyChallenge": {
      "description": "Phản hồi của POST /v1/me/keys/challenge.",
      "type": "object",
      "required": ["nonce"],
      "properties": {
        "nonce": { "$ref": "sync.schema.json#/$defs/Nonce" }
      }
    },
    "RegisterKeyRequest": {
      "description": "Thân của POST /v1/me/keys. Khoá thiết bị (kind device) bắt buộc có nonce và sig (device-key-pop/1); khoá dán tay (kind ssh) thì không. public_key là dòng authorized_keys do người dùng cung cấp, có thể kèm ghi chú; server chuẩn hoá.",
      "type": "object",
      "required": ["kind", "name", "public_key"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "public_key": { "type": "string", "minLength": 1 },
        "nonce": { "$ref": "sync.schema.json#/$defs/Nonce" },
        "sig": { "$ref": "sync.schema.json#/$defs/Signature" },
        "hardware_backed": { "type": "boolean" },
        "security_level": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "device" } } },
          "then": { "required": ["nonce", "sig"] }
        }
      ]
    },
    "AccountKey": {
      "description": "Một khoá công khai của tài khoản.",
      "type": "object",
      "required": ["id", "kind", "name", "fp", "created_at"],
      "properties": {
        "id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "fp": { "$ref": "sync.schema.json#/$defs/Fingerprint" },
        "public_key": { "$ref": "sync.schema.json#/$defs/PublicKeyLine" },
        "hardware_backed": { "type": "boolean" },
        "created_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "device_id": { "$ref": "rpc.schema.json#/$defs/ID" }
      }
    },
    "RegisterKeyResult": {
      "description": "Phản hồi của POST /v1/me/keys.",
      "type": "object",
      "required": ["key"],
      "properties": {
        "key": { "$ref": "#/$defs/AccountKey" },
        "affected_machine_ids": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/ID" },
          "uniqueItems": true
        }
      }
    },
    "KeyList": {
      "description": "Phản hồi của GET /v1/me/keys.",
      "type": "object",
      "properties": {
        "keys": { "type": "array", "items": { "$ref": "#/$defs/AccountKey" } }
      }
    },
    "AffectedMachines": {
      "description": "Phản hồi của thao tác đổi quyền không có kết quả riêng: các máy có snapshot quyền thay đổi. Vắng nghĩa là không máy nào.",
      "type": "object",
      "properties": {
        "affected_machine_ids": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/ID" },
          "uniqueItems": true
        }
      }
    },
    "EnrollStartRequest": {
      "description": "Thân của POST /v1/enroll/start do agent gửi.",
      "type": "object",
      "required": ["host_key", "hostname", "os", "arch", "os_user", "agent_version"],
      "properties": {
        "host_key": { "$ref": "sync.schema.json#/$defs/PublicKeyLine" },
        "hostname": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "os_user": { "type": "string", "minLength": 1 },
        "agent_version": { "type": "string", "minLength": 1 },
        "allowed_cidrs": {
          "type": "array",
          "items": { "$ref": "sync.schema.json#/$defs/CIDR" }
        }
      }
    },
    "EnrollStartResult": {
      "description": "Phản hồi của POST /v1/enroll/start theo RFC 8628 §3.2. user_code dùng 20 chữ cái không có nguyên âm và không nhầm lẫn.",
      "type": "object",
      "required": ["device_code", "user_code", "verification_uri", "expires_in", "interval"],
      "properties": {
        "device_code": { "type": "string", "minLength": 1 },
        "user_code": { "$ref": "#/$defs/UserCode" },
        "verification_uri": { "type": "string", "minLength": 1 },
        "expires_in": { "type": "integer", "minimum": 1 },
        "interval": { "type": "integer", "minimum": 1 }
      }
    },
    "UserCode": {
      "type": "string",
      "pattern": "^[BCDFGHJKLMNPQRSTVWXZ]{4}-[BCDFGHJKLMNPQRSTVWXZ]{4}$"
    },
    "EnrollPollRequest": {
      "description": "Thân của POST /v1/enroll/poll. sig chứng minh agent giữ host key đã khai, ngữ cảnh enroll-pop/1.",
      "type": "object",
      "required": ["device_code", "sig"],
      "properties": {
        "device_code": { "type": "string", "minLength": 1 },
        "sig": { "$ref": "sync.schema.json#/$defs/Signature" }
      }
    },
    "EnrollPollResult": {
      "description": "Phản hồi khi máy đã được duyệt. Khi chưa xong, poll trả lỗi enroll.* (xem http-api.md).",
      "type": "object",
      "required": ["machine_id", "policy_keys"],
      "properties": {
        "machine_id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "policy_keys": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "sync.schema.json#/$defs/PolicyKey" }
        }
      }
    },
    "EnrollInfo": {
      "description": "Phản hồi của GET /v1/enroll/{user_code} cho người đang duyệt.",
      "type": "object",
      "required": ["user_code", "hostname", "os", "arch", "os_user", "host_key_fp", "requested_at", "expires_at"],
      "properties": {
        "user_code": { "$ref": "#/$defs/UserCode" },
        "hostname": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "os_user": { "type": "string", "minLength": 1 },
        "requested_ip": { "type": "string", "minLength": 2 },
        "allowed_cidrs": {
          "type": "array",
          "items": { "$ref": "sync.schema.json#/$defs/CIDR" }
        },
        "host_key_fp": { "$ref": "sync.schema.json#/$defs/Fingerprint" },
        "requested_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "expires_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" }
      }
    },
    "EnrollApproveRequest": {
      "description": "Thân của POST /v1/enroll/{user_code}/approve; phản hồi là Machine vừa tạo.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "Machine": {
      "description": "Một máy (cặp máy và user hệ điều hành) mà tài khoản có quyền. policy_state: in_sync, pending hoặc rejected (tập mở, giá trị lạ coi là pending). role là vai trò của người gọi.",
      "type": "object",
      "required": ["id", "name", "hostname", "os", "arch", "os_user", "host_key_fp", "online", "session_count", "policy_state", "role"],
      "properties": {
        "id": { "$ref": "rpc.schema.json#/$defs/ID" },
        "name": { "type": "string", "minLength": 1 },
        "hostname": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "os_user": { "type": "string", "minLength": 1 },
        "addresses": {
          "type": "array",
          "items": { "$ref": "sync.schema.json#/$defs/Address" }
        },
        "host_key_fp": { "$ref": "sync.schema.json#/$defs/Fingerprint" },
        "online": { "type": "boolean" },
        "session_count": { "type": "integer", "minimum": 0 },
        "last_seen_at": { "$ref": "rpc.schema.json#/$defs/Timestamp" },
        "policy_state": { "type": "string", "minLength": 1 },
        "agent_version": { "type": "string", "minLength": 1 },
        "agent_capabilities": {
          "type": "array",
          "items": { "$ref": "rpc.schema.json#/$defs/Capability" },
          "uniqueItems": true
        },
        "allowed_cidrs": {
          "type": "array",
          "items": { "$ref": "sync.schema.json#/$defs/CIDR" }
        },
        "role": { "type": "string", "minLength": 1 },
        "local_revocations": {
          "type": "array",
          "items": { "$ref": "sync.schema.json#/$defs/LocalRevocation" }
        }
      }
    },
    "MachineList": {
      "description": "Phản hồi của GET /v1/machines.",
      "type": "object",
      "properties": {
        "machines": { "type": "array", "items": { "$ref": "#/$defs/Machine" } }
      }
    },
    "MachinePatch": {
      "description": "Thân của PATCH /v1/machines/{id}; phản hồi là Machine sau khi sửa.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
